# Copy to .env and adjust. Bun auto-loads .env at startup.

# Welcome banner logo variant: "geins" (default) or "litium".
BRAND_LOGO=geins

# Show the prefix flourish before the logo (true/false, default true).
BRAND_PREFIX=true

# Show the "SYNAPSE" suffix flourish after the logo (true/false, default true).
BRAND_SUFIX=true

# API endpoint overrides (optional — defaults shown).
# GEINS_API_URL=https://mgmtapi.geins.services/v2
# GEINS_MGMT_API_URL=https://mgmtapi.geins.io
# GEINS_MERCHANT_API_URL=https://merchantapi.geins.io/graphql
